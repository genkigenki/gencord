# Copy to .env (docker compose) or enter these as environment variables of the Portainer stack.

# NAS / file server (SMB). The user needs read/write on both folders.
NAS_IP=192.168.1.10
SMB_USER=youruser
SMB_PASS=secret
# share/folder the recorder uploads to (WebDAV target on the same NAS)
RECORDINGS_SHARE=Recordings/inbox
# share/folder of your Obsidian vault
VAULT_SHARE=home/Obsidian/MyVault

# Optional: the recordings folder as seen from Windows. Enables "open recording" links
# and clickable timestamps (VLC, see tools/install-gencord-links.ps1). Empty = no links.
RECORDINGS_UNC=\\mynas\Recordings\inbox

# Where notes land inside the vault, and the editable word list
NOTES_DIR=Recordings
WORDLIST=Recordings/_Wortliste.md

# Speech recognition (faster-whisper on an NVIDIA GPU)
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=de
WHISPER_PROMPT=

# Summaries: LM Studio on the Docker host (OpenAI API). For Ollama: LLM_API=ollama, LLM_MODEL=qwen2.5:7b
LLM_API=openai
LLM_MODEL=qwen3.5-9b
NOTE_LANGUAGE=Deutsch

# Speaker separation (pyannote): free Hugging Face read token, after accepting the terms of
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0. Empty = off.
HF_TOKEN=
MAX_SPEAKERS=8

POLL_SECONDS=60
